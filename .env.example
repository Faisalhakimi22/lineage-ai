# ---------------------------------------------------------------------------
# Lineage - environment configuration
#
# Copy to .env and fill in. Every value below is OPTIONAL: with none of them
# set, the app still runs end to end using deterministic lexical matching and
# anonymous (signed-out) access. Analyses are not saved.
# ---------------------------------------------------------------------------

# --- Required to run locally -----------------------------------------------
# The API requires PORT. The frontend defaults to PORT=5174 and BASE_PATH=/;
# set API_PROXY_TARGET when the API runs as a separate local process.
#   API:      PORT=3001
#   Frontend: PORT=5174 BASE_PATH=/ API_PROXY_TARGET=http://localhost:3001

# --- Optional: LLM assistance ----------------------------------------------
# Enables semantic claim extraction and LLM adjudication of ambiguous matches.
# Without it, extraction falls back to longest-sentence heuristics and matching
# runs on the lexical layer alone. Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=
# Defaults to nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=

# --- Optional: semantic matching -------------------------------------------
# Set to "on" to enable local sentence-embedding matching. Requires the
# optional @xenova/transformers dependency, and downloads a ~25MB model on
# first use. Install it with:
# pnpm --filter @workspace/api-server add @xenova/transformers
# Off by default so a demo machine never stalls on a model fetch.
SEMANTIC_MATCHING=

# --- Optional: live web search --------------------------------------------
# Enables bounded multi-query discovery for every analysis. Search results are
# leads only; the provenance pipeline separately acquires a small number of
# public HTML pages, extracts metadata and passages, and reports insufficient
# evidence whenever it cannot support a chronology or mutation. Use ONE key,
# keep it server-side, and never use a VITE_ prefix. Brave takes precedence if
# both keys are set.
BRAVE_SEARCH_API_KEY=
# Alternative provider: https://app.tavily.com/ (free tier available).
TAVILY_API_KEY=
# Values must be positive integers. Search defaults: 5 results/query,
# 12 merged results total, 2 concurrent queries, 8000 ms/query. Hard caps are
# 10/query, 20 total, 3 concurrent queries, and 30000 ms.
LIVE_SEARCH_MAX_RESULTS=
LIVE_SEARCH_MAX_TOTAL_RESULTS=
LIVE_SEARCH_QUERY_CONCURRENCY=
LIVE_SEARCH_TIMEOUT_MS=

# --- Optional: bounded provenance acquisition -----------------------------
# Only the strongest, domain-diverse search leads are opened. Defaults:
# 6 sources, 3 concurrent fetches, 8000 ms/source, 1500000 bytes/source.
# Hard caps in code prevent these values from becoming an unbounded crawler.
PROVENANCE_MAX_SOURCES=
PROVENANCE_ACQUISITION_CONCURRENCY=
PROVENANCE_SOURCE_TIMEOUT_MS=
PROVENANCE_SOURCE_MAX_BYTES=

# --- Optional: runtime limits ---------------------------------------------
# ANALYZE_RATE_LIMIT_PER_MIN must be a positive integer (default 60).
# OCR_MAX_CONCURRENT limits simultaneous Tesseract workers (default 2).
# OCR_TIMEOUT_MS limits one OCR job (default 20000).
ANALYZE_RATE_LIMIT_PER_MIN=
OCR_MAX_CONCURRENT=
OCR_TIMEOUT_MS=

# --- Optional: authentication + persistent history -------------------------
# Server-side Firebase Admin credentials. Supply EITHER the service account
# JSON inline, OR a path via GOOGLE_APPLICATION_CREDENTIALS.
# Without these, /me and /history return AUTH_NOT_CONFIGURED and analyses are
# never persisted. NEVER commit real values.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Optional: Firebase client config (frontend, VITE_ prefix) --------------
# These are client-side Firebase config values and are safe to ship in the
# bundle - they identify the project, they do not authorise access. Access is
# controlled by Firebase security rules and by server-side token verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
